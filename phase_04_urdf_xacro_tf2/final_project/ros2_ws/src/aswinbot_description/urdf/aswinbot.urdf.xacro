<?xml version="1.0"?>
<robot name="AswinBot" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<link name="base_link">
		<visual>
			<geometry>
				<box size="0.4 0.3 0.1"/>
			</geometry>

			<material name="blue">
				<color rgba="0 0 1 1"/>
			</material>
		</visual>
		
		<collision>
			<geometry>
				<box size="0.4 0.3 0.1"/>
			</geometry>
		</collision>
		
		<inertial>
   			 <origin xyz="0 0 0" rpy="0 0 0"/>
   			 <mass value="2.0"/>
   			 <inertia
       				 ixx="0.01667"
			         ixy="0.0"
       				 ixz="0.0"
       				 iyy="0.02833"
       				 iyz="0.0"
       				 izz="0.04167"/>
		 </inertial>
	</link>
	
	<link name="left_wheel_link">
		<visual>
			<origin xyz="0 0 0" rpy="1.5708 0 0"/>
			<geometry>
				<cylinder radius="0.075" length="0.04"/>
			</geometry>

			<material name="black">
				<color rgba="0 0 0 1"/>
			</material>
		</visual>

		<collision>
   			 <origin xyz="0 0 0" rpy="1.5708 0 0"/>
   			 <geometry>
				<cylinder radius="0.075" length="0.04"/>
   			 </geometry>
		</collision>

		<inertial>
                         <origin xyz="0 0 0" rpy="0 0 0"/>
                         <mass value="0.3"/>
                         <inertia
                                 ixx="0.000318125"
                                 ixy="0.0"
                                 ixz="0.0"
                                 iyy="0.00084375"
                                 iyz="0.0"
                                 izz="0.000318125"/>
                </inertial>

	</link>

	 <link name="right_wheel_link">
                <visual>
                        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                        <geometry>
                                <cylinder radius="0.075" length="0.04"/>
                        </geometry>

                        <material name="black">
                                <color rgba="0 0 0 1"/>
                        </material>
                </visual>

                <collision>
                         <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                         <geometry>
                                <cylinder radius="0.075" length="0.04"/>
                         </geometry>
                </collision>

                <inertial>
                         <origin xyz="0 0 0" rpy="0 0 0"/>
                         <mass value="0.3"/>
                         <inertia
                                 ixx="0.000318125"
                                 ixy="0.0"
                                 ixz="0.0"
                                 iyy="0.00084375"
                                 iyz="0.0"
                                 izz="0.000318125"/>
                </inertial>

        </link>

	<link name="camera_link">
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0"/>
                        <geometry>
                                <box size="0.06 0.05 0.04"/>
                        </geometry>

                        <material name="green">
                                <color rgba="0 1 0 1"/>
                        </material>
                </visual>

                <collision>
                         <origin xyz="0 0 0" rpy="0 0 0"/>
                         <geometry>
                                <box size="0.06 0.05 0.04"/>
                         </geometry>
                </collision>

                <inertial>
                         <origin xyz="0 0 0" rpy="0 0 0"/>
                         <mass value="0.1"/>
                         <inertia
                                 ixx="0.00003417"
                                 ixy="0.0"
                                 ixz="0.0"
                                 iyy="0.00004333"
                                 iyz="0.0"
                                 izz="0.00005083"/>
                </inertial>

        </link>

	<link name="lidar_link">
                <visual>
                        <origin xyz="0 0 0" rpy="0 0 0"/>
                        <geometry>
                                <cylinder radius="0.04" length="0.03"/>
                        </geometry>

                        <material name="red">
                                <color rgba="1 0 0 1"/>
                        </material>
                </visual>

                <collision>
                         <origin xyz="0 0 0" rpy="0 0 0"/>
                         <geometry>
                                <cylinder radius="0.04" length="0.03"/>
                         </geometry>
                </collision>

                <inertial>
                         <origin xyz="0 0 0" rpy="0 0 0"/>
                         <mass value="0.15"/>
                         <inertia
                                 ixx="0.00007125"
                                 ixy="0.0"
                                 ixz="0.0"
                                 iyy="0.00007125"
                                 iyz="0.0"
                                 izz="0.000012"/>
                </inertial>

        </link>

        <joint name="lidar_joint" type="fixed">

                 <parent link="base_link"/>
                 <child link="lidar_link"/>
                 <origin xyz="0 0 0.12" rpy="0 0 0"/>

        </joint>

        <joint name="camera_joint" type="fixed">

                 <parent link="base_link"/>
                 <child link="camera_link"/>
                 <origin xyz="0.14 0 0.12" rpy="0 0 0"/>

        </joint>

	<joint name="right_wheel_joint" type="continuous">
   	
		 <parent link="base_link"/>
   		 <child link="right_wheel_link"/>
   		 <origin xyz="0 -0.17 -0.125" rpy="0 0 0"/>
   		 <axis xyz="0 1 0"/>
	
	</joint>

	 <joint name="left_wheel_joint" type="continuous">

                 <parent link="base_link"/>
                 <child link="left_wheel_link"/>
                 <origin xyz="0 0.17 -0.125" rpy="0 0 0"/>
                 <axis xyz="0 1 0"/>

        </joint>

</robot>
